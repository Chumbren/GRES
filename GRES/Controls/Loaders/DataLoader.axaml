<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GRES.ViewModels.Loaders"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GRES.Controls.Loaders.DataLoader"
             x:DataType="vm:DataLoaderViewModel">

    <UserControl.DataTemplates>
      <DataTemplate DataType="{x:Type vm:DataLoaderViewModel}">
        <ContentPresenter 
        IsVisible="False" 
        Content="{Binding $parent[UserControl].Content}" />
      </DataTemplate>
    </UserControl.DataTemplates>
</UserControl>
