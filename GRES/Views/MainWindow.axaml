<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:GRES.Views"
        xmlns:authViews="using:GRES.Views.Auth"
        xmlns:authVM="using:GRES.ViewModels.Auth"
        xmlns:homeView="using:GRES.Views.Home"
        xmlns:homeVM="using:GRES.ViewModels.Home"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GRES.Views.MainWindow"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/avalonia-logo.ico"
        Title="GRES"
        >
           <views:MainView />
    <Window.Background>
        <SolidColorBrush Color="#1e1e1e" />
    </Window.Background>
    <Window.DataTemplates>
       <DataTemplate DataType="{x:Type authVM:AuthViewModel}">
           <authViews:AuthView />
       </DataTemplate>
       <DataTemplate DataType="{x:Type homeVM:HomeViewModel}">
           <homeView:HomeView />
       </DataTemplate>
       
    </Window.DataTemplates>
</Window>
