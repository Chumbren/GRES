<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GRES.Views.Home.CenterPanel">
     <Border Background="#1F1F1F"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Grid RowDefinitions="Auto, *">

            <!-- 1. ПАНЕЛЬ ВКЛАДОК (Tab Bar) -->
            <Border Grid.Row="0"
                    Background="#181818"
                    BorderBrush="#2B2B2B"
                    BorderThickness="0,0,0,1"
                    Height="35">

                <StackPanel Orientation="Horizontal">

                    <!-- Активная вкладка (фон совпадает с рабочей областью + верхняя синяя полоска) -->
                    <Border Background="#1F1F1F"
                            BorderBrush="#2B2B2B"
                            BorderThickness="0,0,1,0"
                            Padding="12,0,8,0">
                        <Grid RowDefinitions="2, *">
                            <!-- Синий акцентный индикатор активной вкладки -->
                            <Border Grid.Row="0" Background="#0078D4" Margin="-12,0,-8,0" />

                            <StackPanel Grid.Row="1" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center" 
                                        Spacing="8">
                                <Image Width="14" 
                                       Height="14" 
                                       Source="/Assets/Img/Home/LeftPanel/left_panel_item_home.png" />
                                <TextBlock Text="MainView.axaml" 
                                           Foreground="#FFFFFF" 
                                           FontSize="12" 
                                           VerticalAlignment="Center" />
                                <Button Content="✕"
                                        FontSize="10"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        Background="Transparent"
                                        Foreground="#CCCCCC"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Неактивная вкладка -->
                    <Border Background="#181818"
                            BorderBrush="#2B2B2B"
                            BorderThickness="0,0,1,0"
                            Padding="12,0,8,0">
                        <StackPanel Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    Spacing="8">
                            <Image Width="14" 
                                   Height="14" 
                                   Opacity="0.7"
                                   Source="/Assets/Img/Home/LeftPanel/left_panel_item_home.png" />
                            <TextBlock Text="BlockContainer.cs" 
                                       Foreground="#969696" 
                                       FontSize="12" 
                                       VerticalAlignment="Center" />
                            <Button Content="✕"
                                    FontSize="10"
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#969696"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- 2. ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ КОНТЕНТА -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *">

                <!-- Хлебные крошки (Breadcrumbs / путь к файлу или разделу) -->
                <Border Grid.Row="0"
                        Background="#1F1F1F"
                        Padding="14,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="GRES" Foreground="#858585" FontSize="11" />
                        <TextBlock Text="›" Foreground="#858585" FontSize="11" />
                        <TextBlock Text="Controls" Foreground="#858585" FontSize="11" />
                        <TextBlock Text="›" Foreground="#858585" FontSize="11" />
                        <TextBlock Text="Blocks" Foreground="#CCCCCC" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Контейнер для вашего динамического содержимого (или блоков) -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border Padding="20">
                        <!-- Сюда можно привязать CurrentPage или положить ваши BlockContainer -->
                        <!-- <ContentPresenter Content="{Binding CurrentContent}" /> -->
                    </Border>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Border>
</UserControl>
