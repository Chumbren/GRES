<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:GRES.ViewModels.Home"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GRES.Views.Home.MenuPanel"
             x:DataType="vm:HomeViewModel">
    <UserControl.DataContext>
      <vm:HomeViewModel/>
    </UserControl.DataContext>

    <Border Background="#181818"
            BorderBrush="#2B2B2B"
            BorderThickness="0,0,0,1"
            Height="35"
            HorizontalAlignment="Stretch"
            PointerPressed="OnTitleBarPointerPressed">

        <Grid ColumnDefinitions="Auto, *, Auto">

            <!-- 1. ЛЕВАЯ ЧАСТЬ: Иконка приложения и стандартное меню -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Spacing="4">

                <!-- Логотип приложения -->
                <Image Width="18" 
                       Height="18" 
                       Margin="0,0,6,0"
                       Source="/Assets/Img/Home/LeftPanel/left_panel_item_home.png" />

                <!-- Выпадающее меню (Файл, Правка, Вид) -->
                <Menu Background="Transparent" Height="28">
                    <MenuItem Header="Файл" Foreground="#CCCCCC" FontSize="12" Padding="8,4">
                        <MenuItem Header="Новый проект" InputGesture="Ctrl+N" />
                        <MenuItem Header="Открыть..." InputGesture="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="Сохранить" InputGesture="Ctrl+S" />
                        <Separator />
                        <MenuItem Header="Выход" />
                    </MenuItem>

                    <MenuItem Header="Правка" Foreground="#CCCCCC" FontSize="12" Padding="8,4">
                        <MenuItem Header="Отменить" InputGesture="Ctrl+Z" />
                        <MenuItem Header="Повторить" InputGesture="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Копировать" InputGesture="Ctrl+C" />
                        <MenuItem Header="Вставить" InputGesture="Ctrl+V" />
                    </MenuItem>

                    <MenuItem Header="Вид" Foreground="#CCCCCC" FontSize="12" Padding="8,4">
                        <MenuItem Header="Палитра команд" InputGesture="Ctrl+Shift+P" />
                        <MenuItem Header="Показать левую панель" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- 2. ЦЕНТРАЛЬНАЯ ЧАСТЬ: Строка поиска / Название проекта (Command Center) -->
            <Border Grid.Column="1"
                    Background="#242424"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="24"
                    MaxWidth="450"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="20,0">
                <TextBlock Text="GRES — Поиск по проекту (Ctrl+P)"
                           Foreground="#858585"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- 3. ПРАВАЯ ЧАСТЬ: Управление панелями и кнопки окна -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Stretch">

                <!-- Кнопка переключения макета -->
                <Button Width="35" 
                        Height="35" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Padding="0"
                        ToolTip.Tip="Переключить боковую панель">
                    <Image Width="16" 
                           Height="16" 
                           Source="/Assets/Img/Home/LeftPanel/left_panel_item_home.png" />
                </Button>

                <!-- Кнопка Свернуть (_) -->
                <Button Content="—" 
                        Width="45" 
                        Height="35" 
                        Background="Transparent" 
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding MinimizeCommand}" />

                <!-- Кнопка Развернуть (□) -->
                <Button Content="▢" 
                        Width="45" 
                        Height="35" 
                        Background="Transparent" 
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ToggleMaximizeCommand}" />

                <!-- Кнопка Закрыть (✕) -->
                <Button Content="✕" 
                        Width="45" 
                        Height="35" 
                        Background="Transparent" 
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding CloseCommand}" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
